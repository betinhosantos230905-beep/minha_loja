# Copie para .env e preencha. NUNCA coloque credenciais reais neste arquivo.
# Gere a SECRET_KEY com:  python -c "import secrets; print(secrets.token_hex(32))"

# --- Aplicação ---
FLASK_DEBUG=0
SECRET_KEY=
HOST=127.0.0.1
PORT=5000

# --- Painel administrativo ---
ADMIN_PASSWORD=

# --- Banco de dados (TiDB Cloud) ---
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=minha_loja
# TiDB Cloud exige conexão segura (TLS):
DB_SSL=true
# Opcional: caminho de um certificado CA. Em branco usa o pacote do certifi.
DB_SSL_CA=

# --- Upload de imagens (Cloudinary, conta própria) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
